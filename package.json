{
  "name": "next-monorepo-template",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "prepare": "husky",
    "test": "turbo test && vitest run --config vitest.config.ts",
    "typecheck": "turbo typecheck",
    "verify": "bun run scripts/verify.mts full",
    "verify:e2e": "bun run scripts/verify.mts e2e",
    "verify:fast": "bun run scripts/verify.mts fast",
    "verify:template": "bun run scripts/verify-template.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^26.6.5",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.7",
    "typescript": "^5",
    "ultracite": "8.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "bun@1.4.2"
}
